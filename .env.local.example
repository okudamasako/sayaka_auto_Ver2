# ===================================================
# SNS Post Generator - 環境変数設定ファイル
# Vercel の Environment Variables にも同じ内容を設定してください
# ===================================================

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Google Sheets
# サービスアカウントのJSONキーをBase64エンコードした値
GOOGLE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwicHJvamVjdF9pZCI6...
# スプレッドシートのID（URLの /d/XXXX/edit の XXXX 部分）
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
# シート名（タブ名）
GOOGLE_SHEET_NAME=SNS投稿履歴

# Slack
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Gmail (nodemailer + Gmail OAuth2 または App Password)
GMAIL_USER=your-email@gmail.com
# Gmailアプリパスワード（Googleアカウント > セキュリティ > アプリパスワード）
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# 通知送信先アドレス
NOTIFY_EMAIL_TO=notify-target@example.com

# アプリ設定
NEXT_PUBLIC_APP_NAME=SNS投稿文ジェネレーター
